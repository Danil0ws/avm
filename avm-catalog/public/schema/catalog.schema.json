{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AVM Catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "tool", "source", "versions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool": {"type": "string"},
    "source": {"type": "string"},
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "artifacts"],
        "properties": {
          "version": {"type": "string"},
          "release_date": {"type": ["string", "null"]},
          "channel": {"type": ["string", "null"]},
          "distribution": {"type": ["string", "null"]},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["os", "arch", "archive_type", "url", "sha256"],
              "properties": {
                "os": {"type": "string", "enum": ["windows", "macos", "linux"]},
                "arch": {"type": "string", "enum": ["x64", "arm64"]},
                "archive_type": {"type": "string"},
                "url": {"type": "string", "format": "uri"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size_bytes": {"type": ["integer", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
